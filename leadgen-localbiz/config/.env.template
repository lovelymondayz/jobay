# Lead Gen Pipeline Environment
# Copy to /root/hermes/leadgen-localbiz/.env and fill in

# PostgreSQL (Docker: leadgen-postgres, port 5433)
PG_HOST=localhost
PG_PORT=5433
PG_DB=leadgen
PG_USER=leadgen
PG_PASSWORD=CHANGEME

# Email SMTP (Zoho free tier recommended)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@arjism.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Arjism Web Studio

# Discord webhook for alerts
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Optional: Yelp Fusion API (free 5000 calls/day)
# Get key: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# Cloudflare Pages
CF_API_TOKEN=
CF_ZONE_ID=
CF_ACCOUNT_ID=
